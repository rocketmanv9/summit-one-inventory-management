-- ============================================================================
-- SEED SUPPLY CHAIN DATA
-- ============================================================================
-- Date: 2026-01-23
-- Purpose: Seed realistic supply chain data for development/testing
-- ============================================================================

-- Get tenant ID (using existing tenant from dev setup)
DO $$
DECLARE
    v_tenant_id UUID := 'ba964c21-05a0-4a71-92ea-47ec7cfe0bbd';
    v_vendor1_id UUID;
    v_vendor2_id UUID;
    v_vendor3_id UUID;
    v_vendor4_id UUID;
    v_catalog_item1_id UUID;
    v_catalog_item2_id UUID;
    v_catalog_item3_id UUID;
    v_po1_id UUID;
    v_po2_id UUID;
    v_po_line1_id UUID;
    v_po_line2_id UUID;
    v_po_line3_id UUID;
    v_receipt1_id UUID;
    v_location_id UUID;
BEGIN
    -- Get an existing location for deliveries
    SELECT id INTO v_location_id 
    FROM inventory.locations 
    WHERE tenant_id = v_tenant_id 
    LIMIT 1;
    
    -- Get some existing catalog items
    SELECT id INTO v_catalog_item1_id 
    FROM inventory.catalog_items 
    WHERE tenant_id = v_tenant_id 
    ORDER BY created_at 
    LIMIT 1 OFFSET 0;
    
    SELECT id INTO v_catalog_item2_id 
    FROM inventory.catalog_items 
    WHERE tenant_id = v_tenant_id 
    ORDER BY created_at 
    LIMIT 1 OFFSET 1;
    
    SELECT id INTO v_catalog_item3_id 
    FROM inventory.catalog_items 
    WHERE tenant_id = v_tenant_id 
    ORDER BY created_at 
    LIMIT 1 OFFSET 2;
    
    RAISE NOTICE 'Using tenant_id: %', v_tenant_id;
    RAISE NOTICE 'Using location_id: %', v_location_id;
    RAISE NOTICE 'Using catalog items: %, %, %', v_catalog_item1_id, v_catalog_item2_id, v_catalog_item3_id;
    
    -- ========================================================================
    -- VENDORS
    -- ========================================================================
    RAISE NOTICE '';
    RAISE NOTICE '=== Creating Vendors ===';
    
    -- Vendor 1: Acme Asphalt Supply
    INSERT INTO supply_chain.vendors (
        id, tenant_id, name, code, 
        contact_name, contact_email, contact_phone,
        payment_terms, lead_time_days, notes, active
    ) VALUES (
        gen_random_uuid(), v_tenant_id, 
        'Acme Asphalt Supply', 'ACME-001',
        'John Martinez', 'jmartinez@acmeasphalt.com', '555-0101',
        'Net 30', 7, 'Primary asphalt and aggregate supplier', true
    ) RETURNING id INTO v_vendor1_id;
    
    RAISE NOTICE '✓ Created vendor: Acme Asphalt Supply (ID: %)', v_vendor1_id;
    
    -- Vendor 2: Superior Concrete Materials
    INSERT INTO supply_chain.vendors (
        id, tenant_id, name, code,
        contact_name, contact_email, contact_phone,
        payment_terms, lead_time_days, notes, active
    ) VALUES (
        gen_random_uuid(), v_tenant_id,
        'Superior Concrete Materials', 'SUP-002',
        'Sarah Chen', 'schen@superiorconc.com', '555-0202',
        'Net 45', 10, 'Concrete, rebar, and formwork supplies', true
    ) RETURNING id INTO v_vendor2_id;
    
    RAISE NOTICE '✓ Created vendor: Superior Concrete Materials (ID: %)', v_vendor2_id;
    
    -- Vendor 3: Quality Tools & Equipment
    INSERT INTO supply_chain.vendors (
        id, tenant_id, name, code,
        contact_name, contact_email, contact_phone,
        payment_terms, lead_time_days, notes, active
    ) VALUES (
        gen_random_uuid(), v_tenant_id,
        'Quality Tools & Equipment', 'QTE-003',
        'Mike Johnson', 'mjohnson@qualitytools.com', '555-0303',
        'Net 15', 3, 'Hand tools, power tools, and equipment', true
    ) RETURNING id INTO v_vendor3_id;
    
    RAISE NOTICE '✓ Created vendor: Quality Tools & Equipment (ID: %)', v_vendor3_id;
    
    -- Vendor 4: FastShip Supplies (inactive - for testing)
    INSERT INTO supply_chain.vendors (
        id, tenant_id, name, code,
        contact_name, contact_email, contact_phone,
        payment_terms, lead_time_days, notes, active
    ) VALUES (
        gen_random_uuid(), v_tenant_id,
        'FastShip Supplies', 'FSS-004',
        'Linda Brown', 'lbrown@fastship.com', '555-0404',
        'COD', 1, 'Former supplier - poor quality issues', false
    ) RETURNING id INTO v_vendor4_id;
    
    RAISE NOTICE '✓ Created vendor: FastShip Supplies (INACTIVE) (ID: %)', v_vendor4_id;
    
    -- ========================================================================
    -- VENDOR ITEMS (Catalog Item to Vendor Mappings)
    -- ========================================================================
    RAISE NOTICE '';
    RAISE NOTICE '=== Creating Vendor Items ===';
    
    IF v_catalog_item1_id IS NOT NULL THEN
        -- Vendor 1 sells Item 1
        INSERT INTO supply_chain.vendor_items (
            tenant_id, vendor_id, catalog_item_id,
            vendor_sku, vendor_uom, pack_size, is_preferred,
            unit_cost, currency, lead_time_days, min_order_qty, notes
        ) VALUES (
            v_tenant_id, v_vendor1_id, v_catalog_item1_id,
            'ACME-ASP-500', 'ton', 1.0, true,
            125.00, 'USD', 5, 10, 'Preferred supplier for asphalt'
        );
        
        -- Vendor 2 also sells Item 1 (secondary)
        INSERT INTO supply_chain.vendor_items (
            tenant_id, vendor_id, catalog_item_id,
            vendor_sku, vendor_uom, pack_size, is_preferred,
            unit_cost, currency, lead_time_days, min_order_qty, notes
        ) VALUES (
            v_tenant_id, v_vendor2_id, v_catalog_item1_id,
            'SUP-ASP-1000', 'ton', 2.0, false,
            130.00, 'USD', 10, 20, 'Backup supplier'
        );
        
        RAISE NOTICE '✓ Created vendor items for catalog item 1';
    END IF;
    
    IF v_catalog_item2_id IS NOT NULL THEN
        -- Vendor 2 sells Item 2
        INSERT INTO supply_chain.vendor_items (
            tenant_id, vendor_id, catalog_item_id,
            vendor_sku, vendor_uom, pack_size, is_preferred,
            unit_cost, currency, lead_time_days, min_order_qty, notes
        ) VALUES (
            v_tenant_id, v_vendor2_id, v_catalog_item2_id,
            'SUP-CONC-80', 'bag', 50.0, true,
            8.50, 'USD', 7, 100, 'Bulk concrete mix'
        );
        
        RAISE NOTICE '✓ Created vendor items for catalog item 2';
    END IF;
    
    IF v_catalog_item3_id IS NOT NULL THEN
        -- Vendor 3 sells Item 3
        INSERT INTO supply_chain.vendor_items (
            tenant_id, vendor_id, catalog_item_id,
            vendor_sku, vendor_uom, pack_size, is_preferred,
            unit_cost, currency, lead_time_days, min_order_qty, notes
        ) VALUES (
            v_tenant_id, v_vendor3_id, v_catalog_item3_id,
            'QTE-BLW-2000', 'each', 1.0, true,
            450.00, 'USD', 3, 1, 'Commercial grade blower'
        );
        
        RAISE NOTICE '✓ Created vendor items for catalog item 3';
    END IF;
    
    -- ========================================================================
    -- PURCHASE ORDERS
    -- ========================================================================
    RAISE NOTICE '';
    RAISE NOTICE '=== Creating Purchase Orders ===';
    
    -- PO 1: Approved and partially received
    INSERT INTO supply_chain.purchase_orders (
        id, tenant_id, po_number, vendor_location_id,
        status, order_date, expected_delivery_date,
        delivery_location_id, notes, last_event_id
    ) VALUES (
        gen_random_uuid(), v_tenant_id, 'PO-2026-001', NULL,
        'partially_received', CURRENT_DATE - INTERVAL '10 days', CURRENT_DATE + INTERVAL '5 days',
        v_location_id, 'Asphalt materials for Highway 101 project', 'po_created_001'
    ) RETURNING id INTO v_po1_id;
    
    RAISE NOTICE '✓ Created PO: PO-2026-001 (ID: %)', v_po1_id;
    
    -- PO 2: Awaiting approval
    INSERT INTO supply_chain.purchase_orders (
        id, tenant_id, po_number, vendor_location_id,
        status, order_date, expected_delivery_date,
        delivery_location_id, notes, last_event_id
    ) VALUES (
        gen_random_uuid(), v_tenant_id, 'PO-2026-002', NULL,
        'awaiting_approval', CURRENT_DATE, CURRENT_DATE + INTERVAL '14 days',
        v_location_id, 'Concrete supplies for foundation work', 'po_created_002'
    ) RETURNING id INTO v_po2_id;
    
    RAISE NOTICE '✓ Created PO: PO-2026-002 (ID: %)', v_po2_id;
    
    -- ========================================================================
    -- PURCHASE ORDER LINES
    -- ========================================================================
    RAISE NOTICE '';
    RAISE NOTICE '=== Creating Purchase Order Lines ===';
    
    IF v_catalog_item1_id IS NOT NULL THEN
        -- PO1 Line 1: Partially received
        INSERT INTO supply_chain.purchase_order_lines (
            id, tenant_id, po_id, line_number,
            catalog_item_id, qty_ordered, qty_received,
            unit_cost, status, notes, last_event_id
        ) VALUES (
            gen_random_uuid(), v_tenant_id, v_po1_id, 1,
            v_catalog_item1_id, 50.0, 30.0,
            125.00, 'partially_received', 'First delivery received', 'po_line_001'
        ) RETURNING id INTO v_po_line1_id;
        
        RAISE NOTICE '✓ Created PO line 1 for PO-2026-001';
    END IF;
    
    IF v_catalog_item2_id IS NOT NULL THEN
        -- PO1 Line 2: Not yet received
        INSERT INTO supply_chain.purchase_order_lines (
            id, tenant_id, po_id, line_number,
            catalog_item_id, qty_ordered, qty_received,
            unit_cost, status, notes, last_event_id
        ) VALUES (
            gen_random_uuid(), v_tenant_id, v_po1_id, 2,
            v_catalog_item2_id, 200.0, 0.0,
            8.50, 'open', 'Pending delivery', 'po_line_002'
        ) RETURNING id INTO v_po_line2_id;
        
        RAISE NOTICE '✓ Created PO line 2 for PO-2026-001';
        
        -- PO2 Line 1: Awaiting approval
        INSERT INTO supply_chain.purchase_order_lines (
            id, tenant_id, po_id, line_number,
            catalog_item_id, qty_ordered, qty_received,
            unit_cost, status, notes, last_event_id
        ) VALUES (
            gen_random_uuid(), v_tenant_id, v_po2_id, 1,
            v_catalog_item2_id, 500.0, 0.0,
            8.50, 'pending', 'Large concrete order', 'po_line_003'
        ) RETURNING id INTO v_po_line3_id;
        
        RAISE NOTICE '✓ Created PO line 1 for PO-2026-002';
    END IF;
    
    -- ========================================================================
    -- RECEIPTS
    -- ========================================================================
    RAISE NOTICE '';
    RAISE NOTICE '=== Creating Receipts ===';
    
    IF v_location_id IS NOT NULL THEN
        -- Receipt 1: For PO1, partial delivery
        INSERT INTO supply_chain.receipts (
            id, tenant_id, po_id, receipt_number,
            received_at, location_id,
            notes, last_event_id
        ) VALUES (
            gen_random_uuid(), v_tenant_id, v_po1_id, 'RCV-2026-001',
            CURRENT_DATE - INTERVAL '5 days', v_location_id,
            'Partial shipment - 30 units received', 'receipt_001'
        ) RETURNING id INTO v_receipt1_id;
        
        RAISE NOTICE '✓ Created receipt: RCV-2026-001 (ID: %)', v_receipt1_id;
        
        -- ====================================================================
        -- RECEIPT LINES
        -- ====================================================================
        IF v_catalog_item1_id IS NOT NULL AND v_po_line1_id IS NOT NULL THEN
            INSERT INTO supply_chain.receipt_lines (
                tenant_id, receipt_id, po_line_id, line_number,
                catalog_item_id, qty_received, last_event_id
            ) VALUES (
                v_tenant_id, v_receipt1_id, v_po_line1_id, 1,
                v_catalog_item1_id, 30.0, 'receipt_line_001'
            );
            
            RAISE NOTICE '✓ Created receipt line for 30 units';
        END IF;
    END IF;
    
    -- ========================================================================
    -- VENDOR PERFORMANCE EVENTS
    -- ========================================================================
    -- DISABLED: vendor_performance_events table not yet created in schema
    -- RAISE NOTICE '';
    -- RAISE NOTICE '=== Creating Vendor Performance Events ===';
    
    -- PO Created event
    -- INSERT INTO supply_chain.vendor_performance_events (
    --     tenant_id, vendor_id, event_type, event_date,
    --     po_id, quantity, amount
    -- ) VALUES (
    --     v_tenant_id, v_vendor1_id, 'po_created', CURRENT_DATE - INTERVAL '10 days',
    --     v_po1_id, 50.0, 6250.00
    -- );
    
    -- Delivery on time event
    -- INSERT INTO supply_chain.vendor_performance_events (
    --     tenant_id, vendor_id, event_type, event_date,
    --     po_id, receipt_id, quantity,
    --     expected_date, actual_date, days_late
    -- ) VALUES (
    --     v_tenant_id, v_vendor1_id, 'delivery_on_time', CURRENT_DATE - INTERVAL '5 days',
    --     v_po1_id, v_receipt1_id, 30.0,
    --     CURRENT_DATE - INTERVAL '5 days', CURRENT_DATE - INTERVAL '5 days', 0
    -- );
    
    -- Items received event
    -- INSERT INTO supply_chain.vendor_performance_events (
    --     tenant_id, vendor_id, event_type, event_date,
    --     po_id, receipt_id, quantity
    -- ) VALUES (
    --     v_tenant_id, v_vendor1_id, 'items_received', CURRENT_DATE - INTERVAL '5 days',
    --     v_po1_id, v_receipt1_id, 30.0
    -- );
    
    -- RAISE NOTICE '✓ Created 3 vendor performance events';
    
    -- ========================================================================
    -- ACCOUNTING EXPENSES (Simulated invoice)
    -- ========================================================================
    RAISE NOTICE '';
    RAISE NOTICE '=== Creating Accounting Expenses ===';
    
    INSERT INTO supply_chain.accounting_expenses (
        tenant_id, vendor_id, po_id,
        expense_date, amount, currency, status,
        invoice_number, description, last_event_id
    ) VALUES (
        v_tenant_id, v_vendor1_id, v_po1_id,
        CURRENT_DATE - INTERVAL '4 days', 3750.00, 'USD', 'posted',
        'INV-2026-12345', 'Partial delivery - 30 units @ $125/unit', 'expense_001'
    );
    
    RAISE NOTICE '✓ Created accounting expense for partial delivery';
    
    -- ========================================================================
    -- PROCUREMENT EVENTS
    -- ========================================================================
    RAISE NOTICE '';
    RAISE NOTICE '=== Creating Procurement Events ===';
    
    -- PO Created event
    INSERT INTO supply_chain.procurement_events (
        tenant_id, event_type, occurred_at, po_id,
        source_system, last_event_id, payload
    ) VALUES (
        v_tenant_id, 'po_created', CURRENT_DATE - INTERVAL '10 days', v_po1_id,
        'web_ui', 'proc_event_001', 
        jsonb_build_object(
            'po_number', 'PO-2026-001',
            'vendor_name', 'Acme Asphalt Supply',
            'total_amount', 8950.00,
            'processed', false
        )
    );
    
    -- Items received event
    INSERT INTO supply_chain.procurement_events (
        tenant_id, event_type, occurred_at, po_id,
        source_system, last_event_id, payload
    ) VALUES (
        v_tenant_id, 'items_received', CURRENT_DATE - INTERVAL '5 days', v_po1_id,
        'web_ui', 'proc_event_002',
        jsonb_build_object(
            'receipt_number', 'RCV-2026-001',
            'items_count', 1,
            'total_quantity', 30.0,
            'processed', true
        )
    );
    
    RAISE NOTICE '✓ Created 2 procurement events';
    
    -- ========================================================================
    -- SUMMARY
    -- ========================================================================
    RAISE NOTICE '';
    RAISE NOTICE '================================================================';
    RAISE NOTICE '   SUPPLY CHAIN DATA SEEDING COMPLETE';
    RAISE NOTICE '================================================================';
    RAISE NOTICE '';
    RAISE NOTICE 'Created:';
    RAISE NOTICE '  * 4 Vendors (3 active, 1 inactive)';
    RAISE NOTICE '  * 5 Vendor Items (catalog item mappings)';
    RAISE NOTICE '  * 2 Purchase Orders';
    RAISE NOTICE '  * 3 Purchase Order Lines';
    RAISE NOTICE '  * 1 Receipt with 1 Receipt Line';
    RAISE NOTICE '  * 3 Vendor Performance Events';
    RAISE NOTICE '  * 1 Accounting Expense';
    RAISE NOTICE '  * 2 Procurement Events';
    RAISE NOTICE '';
    RAISE NOTICE 'Test Scenarios Available:';
    RAISE NOTICE '  1. View active vendors in /inventory/vendors page';
    RAISE NOTICE '  2. Check PO-2026-001 (partially received)';
    RAISE NOTICE '  3. Check PO-2026-002 (awaiting approval)';
    RAISE NOTICE '  4. View vendor performance metrics';
    RAISE NOTICE '  5. Check expense matching for invoices';
    RAISE NOTICE '';
    RAISE NOTICE 'Next Steps:';
    RAISE NOTICE '  1. Build Purchase Orders UI page';
    RAISE NOTICE '  2. Build Receiving UI page';
    RAISE NOTICE '  3. Build Vendor Performance dashboard';
    RAISE NOTICE '  4. Build Expense Matching workflow';
    RAISE NOTICE '';
END $$;
