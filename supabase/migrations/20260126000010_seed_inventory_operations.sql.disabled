-- Seed Inventory Operations Data
-- This migration populates sample data for testing all inventory operations
-- Including: Purchase Orders, Receipts, Transfers, Reservations, Cycle Counts

-- Set tenant and user context
DO $$
DECLARE
  v_tenant_id UUID := 'ae837809-1a24-4ab5-ba06-34fd98c05f48';
  v_user_id UUID := gen_random_uuid(); -- Generate a test user ID
  
  -- Existing data IDs
  v_vendor_id UUID;
  v_warehouse_id UUID;
  v_store_id UUID;
  v_truck_id UUID;
  v_asphalt_id UUID;
  v_concrete_id UUID;
  v_sand_id UUID;
  v_rake_id UUID;
  v_vest_id UUID;
  
  -- New IDs we'll create
  v_po1_id UUID := gen_random_uuid();
  v_po2_id UUID := gen_random_uuid();
  v_po1_line1_id UUID := gen_random_uuid();
  v_po1_line2_id UUID := gen_random_uuid();
  v_receipt1_id UUID := gen_random_uuid();
  v_receipt2_id UUID := gen_random_uuid();
  v_transfer1_id UUID := gen_random_uuid();
  v_transfer2_id UUID := gen_random_uuid();
  v_cycle_count1_id UUID := gen_random_uuid();
  
BEGIN
  -- Get existing vendor ID (or create vendors if needed)
  SELECT id INTO v_vendor_id FROM supply_chain.vendors WHERE tenant_id = v_tenant_id LIMIT 1;
  
  -- If no vendor exists, create one
  IF v_vendor_id IS NULL THEN
    v_vendor_id := gen_random_uuid();
    INSERT INTO supply_chain.vendors (id, tenant_id, name, code, contact_email, active)
    VALUES 
      (v_vendor_id, v_tenant_id, 'ABC Materials Supply', 'VENDOR-001', 'sales@abcmaterials.com', true);
  END IF;
  
  -- Get existing location IDs
  SELECT id INTO v_warehouse_id FROM inventory.locations WHERE tenant_id = v_tenant_id AND name = 'Main Warehouse';
  SELECT id INTO v_store_id FROM inventory.locations WHERE tenant_id = v_tenant_id AND name = 'Downtown Store';
  SELECT id INTO v_truck_id FROM inventory.locations WHERE tenant_id = v_tenant_id AND name = 'Truck #1';
  
  -- Get existing catalog item IDs
  SELECT id INTO v_asphalt_id FROM inventory.catalog_items WHERE tenant_id = v_tenant_id AND sku = 'ASPH-001';
  SELECT id INTO v_concrete_id FROM inventory.catalog_items WHERE tenant_id = v_tenant_id AND sku = 'CONC-001';
  SELECT id INTO v_sand_id FROM inventory.catalog_items WHERE tenant_id = v_tenant_id AND sku = 'AGG-001';
  SELECT id INTO v_rake_id FROM inventory.catalog_items WHERE tenant_id = v_tenant_id AND sku = 'TOOL-001';
  SELECT id INTO v_vest_id FROM inventory.catalog_items WHERE tenant_id = v_tenant_id AND sku = 'SAFE-001';
  
  -- =====================================================
  -- 1. PURCHASE ORDERS
  -- =====================================================
  RAISE NOTICE 'Creating Purchase Orders...';
  
  INSERT INTO supply_chain.purchase_orders (
    id, tenant_id, po_number, vendor_id, status, order_date, expected_delivery_date,
    delivery_location_id, notes, last_event_id
  ) VALUES 
    (
      v_po1_id, v_tenant_id, 'PO-2026-001', v_vendor_id, 'approved', 
      CURRENT_DATE - INTERVAL '10 days', CURRENT_DATE + INTERVAL '5 days',
      v_warehouse_id, 'Monthly materials order - asphalt and concrete', 'seed-po-1'
    ),
    (
      v_po2_id, v_tenant_id, 'PO-2026-002', v_vendor_id, 'draft',
      CURRENT_DATE - INTERVAL '5 days', CURRENT_DATE + INTERVAL '10 days',
      v_warehouse_id, 'Tools and safety equipment restock', 'seed-po-2'
    );
  
  -- Purchase Order Lines
  INSERT INTO supply_chain.purchase_order_lines (
    id, tenant_id, po_id, line_number, catalog_item_id,
    qty_ordered, unit_cost, last_event_id
  ) VALUES
    -- PO-2026-001 lines
    (v_po1_line1_id, v_tenant_id, v_po1_id, 1, v_asphalt_id, 100, 75.00, 'seed-po-line-1'),
    (v_po1_line2_id, v_tenant_id, v_po1_id, 2, v_concrete_id, 75, 100.00, 'seed-po-line-2'),
    -- PO-2026-002 lines
    (gen_random_uuid(), v_tenant_id, v_po2_id, 1, v_rake_id, 25, 120.00, 'seed-po-line-3'),
    (gen_random_uuid(), v_tenant_id, v_po2_id, 2, v_vest_id, 100, 20.00, 'seed-po-line-4');
  
  -- =====================================================
  -- 2. RECEIPTS (Receiving)
  -- =====================================================
  RAISE NOTICE 'Creating Receipts...';
  
  INSERT INTO supply_chain.receipts (
    id, tenant_id, receipt_number, po_id, received_at,
    location_id, notes, last_event_id
  ) VALUES
    (
      v_receipt1_id, v_tenant_id, 'RCV-2026-001', v_po1_id, CURRENT_DATE - INTERVAL '3 days',
      v_warehouse_id, 'Partial delivery - asphalt only', 'seed-receipt-1'
    ),
    (
      v_receipt2_id, v_tenant_id, 'RCV-2026-002', v_po1_id, CURRENT_DATE - INTERVAL '1 day',
      v_warehouse_id, 'Second delivery - concrete', 'seed-receipt-2'
    );
  
  -- Receipt Lines
  INSERT INTO supply_chain.receipt_lines (
    id, tenant_id, receipt_id, po_line_id, line_number, catalog_item_id,
    qty_received, last_event_id
  ) VALUES
    -- RCV-2026-001 (partial asphalt)
    (gen_random_uuid(), v_tenant_id, v_receipt1_id, v_po1_line1_id, 1, v_asphalt_id, 60, 'seed-receipt-line-1'),
    -- RCV-2026-002 (concrete)
    (gen_random_uuid(), v_tenant_id, v_receipt2_id, v_po1_line2_id, 1, v_concrete_id, 75, 'seed-receipt-line-2');
  
  -- =====================================================
  -- 3. UPDATE STOCK BALANCES (from receipts)
  -- =====================================================
  RAISE NOTICE 'Updating Stock Balances...';
  
  -- Update or insert stock balances for received items
  INSERT INTO inventory.stock_balances (
    id, tenant_id, catalog_item_id, location_id, 
    qty_on_hand, qty_reserved
  ) VALUES
    (gen_random_uuid(), v_tenant_id, v_asphalt_id, v_warehouse_id, 60, 0),
    (gen_random_uuid(), v_tenant_id, v_concrete_id, v_warehouse_id, 75, 0),
    (gen_random_uuid(), v_tenant_id, v_sand_id, v_warehouse_id, 150, 20),
    (gen_random_uuid(), v_tenant_id, v_rake_id, v_warehouse_id, 15, 3),
    (gen_random_uuid(), v_tenant_id, v_vest_id, v_warehouse_id, 50, 10),
    (gen_random_uuid(), v_tenant_id, v_asphalt_id, v_store_id, 25, 5),
    (gen_random_uuid(), v_tenant_id, v_sand_id, v_store_id, 40, 0)
  ON CONFLICT (tenant_id, catalog_item_id, location_id) 
  DO UPDATE SET 
    qty_on_hand = EXCLUDED.qty_on_hand,
    qty_reserved = EXCLUDED.qty_reserved,
    updated_at = CURRENT_TIMESTAMP;
  
  -- =====================================================
  -- 4. TRANSFERS
  -- =====================================================
  RAISE NOTICE 'Creating Transfers...';
  
  INSERT INTO inventory.transfers (
    id, tenant_id, transfer_number, from_location_id, to_location_id,
    status, initiated_at, completed_at,
    notes, last_event_id
  ) VALUES
    (
      v_transfer1_id, v_tenant_id, 'TXF-2026-001', v_warehouse_id, v_store_id,
      'completed', CURRENT_DATE - INTERVAL '5 days', CURRENT_DATE - INTERVAL '4 days',
      'Weekly restock to Downtown Store', 'seed-transfer-1'
    ),
    (
      v_transfer2_id, v_tenant_id, 'TXF-2026-002', v_warehouse_id, v_truck_id,
      'in_transit', CURRENT_DATE - INTERVAL '1 day', NULL,
      'Job site delivery for Project #451', 'seed-transfer-2'
    );
  
  -- Transfer Lines
  INSERT INTO inventory.transfer_lines (
    id, tenant_id, transfer_id, line_number, catalog_item_id, qty, last_event_id
  ) VALUES
    -- TXF-2026-001 lines (completed)
    (gen_random_uuid(), v_tenant_id, v_transfer1_id, 1, v_asphalt_id, 25, 'seed-txf-line-1'),
    (gen_random_uuid(), v_tenant_id, v_transfer1_id, 2, v_sand_id, 40, 'seed-txf-line-2'),
    -- TXF-2026-002 lines (in transit)
    (gen_random_uuid(), v_tenant_id, v_transfer2_id, 1, v_concrete_id, 20, 'seed-txf-line-3'),
    (gen_random_uuid(), v_tenant_id, v_transfer2_id, 2, v_rake_id, 3, 'seed-txf-line-4');
  
  -- =====================================================
  -- 5. RESERVATIONS
  -- =====================================================
  RAISE NOTICE 'Creating Reservations...';
  
  INSERT INTO inventory.reservations (
    id, tenant_id, catalog_item_id, location_id,
    qty, status, needed_by, last_event_id
  ) VALUES
    (
      gen_random_uuid(), v_tenant_id, v_sand_id, v_warehouse_id,
      20, 'active', CURRENT_DATE + INTERVAL '30 days', 'seed-rsv-1'
    ),
    (
      gen_random_uuid(), v_tenant_id, v_vest_id, v_warehouse_id,
      10, 'active', CURRENT_DATE + INTERVAL '14 days', 'seed-rsv-2'
    ),
    (
      gen_random_uuid(), v_tenant_id, v_asphalt_id, v_store_id,
      5, 'active', CURRENT_DATE + INTERVAL '7 days', 'seed-rsv-3'
    );
  
  -- =====================================================
  -- 6. CYCLE COUNTS
  -- =====================================================
  RAISE NOTICE 'Creating Cycle Counts...';
  
  INSERT INTO inventory.cycle_counts (
    id, tenant_id, count_number, location_id,
    status, scheduled_for, started_at, completed_at,
    notes, last_event_id
  ) VALUES
    (
      v_cycle_count1_id, v_tenant_id, 'CC-2026-001', v_warehouse_id,
      'completed', CURRENT_DATE - INTERVAL '7 days', CURRENT_DATE - INTERVAL '7 days', CURRENT_DATE - INTERVAL '7 days',
      'Monthly full count - Main Warehouse', 'seed-cc-1'
    );
  
  -- Cycle Count Lines
  INSERT INTO inventory.cycle_count_lines (
    id, tenant_id, cycle_count_id, line_number, catalog_item_id, location_id,
    qty_expected, qty_counted, last_event_id
  ) VALUES
    -- CC-2026-001 lines (completed - found discrepancies)
    (gen_random_uuid(), v_tenant_id, v_cycle_count1_id, 1, v_asphalt_id, v_warehouse_id, 60, 60, 'seed-cc-line-1'),
    (gen_random_uuid(), v_tenant_id, v_cycle_count1_id, 2, v_concrete_id, v_warehouse_id, 75, 73, 'seed-cc-line-2'),
    (gen_random_uuid(), v_tenant_id, v_cycle_count1_id, 3, v_sand_id, v_warehouse_id, 150, 152, 'seed-cc-line-3'),
    (gen_random_uuid(), v_tenant_id, v_cycle_count1_id, 4, v_rake_id, v_warehouse_id, 15, 15, 'seed-cc-line-4'),
    (gen_random_uuid(), v_tenant_id, v_cycle_count1_id, 5, v_vest_id, v_warehouse_id, 50, 48, 'seed-cc-line-5');
  
  RAISE NOTICE 'Seed data created successfully!';
  RAISE NOTICE 'Summary:';
  RAISE NOTICE '  - 2 Purchase Orders with 4 line items';
  RAISE NOTICE '  - 2 Receipts with received goods';
  RAISE NOTICE '  - 7 Stock Balance records across 2 locations';
  RAISE NOTICE '  - 2 Transfers (1 completed, 1 in-transit) with 4 line items';
  RAISE NOTICE '  - 3 Reservations (all active)';
  RAISE NOTICE '  - 1 Cycle Count (completed) with 5 line items';
  
END $$;
