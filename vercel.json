{
  "installCommand": "echo \"$NPM_RC\" > .npmrc && npm ci",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/system/cron/gmail-reply-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/system/cron/auto-reorder",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/system/cron/integrity-check",
      "schedule": "30 11 * * *"
    }
  ]
}
