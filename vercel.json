{
  "installCommand": "echo \"$NPM_RC\" > .npmrc && npm ci",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/system/cron/gmail-reply-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/system/cron/collect-documents",
      "schedule": "15 */3 * * *"
    },
    {
      "path": "/api/system/cron/auto-reorder",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/system/cron/materialize-counts",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/system/cron/auto-schedule-counts",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/system/cron/integrity-check",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/system/cron/receipt-nudges",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/system/cron/schema-drift-audit",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/system/cron/agent-suggestions",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/system/cron/item-suggestions",
      "schedule": "45 13 * * *"
    }
  ]
}
